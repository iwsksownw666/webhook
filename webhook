local function currentBiome()
    if ServerReplica and type(ServerReplica.Data) == "table" then
        local replicaBiome = normalizeBiome(ServerReplica.Data.BiomeName) or normalizeBiome(ServerReplica.Data.Biome)
        if replicaBiome then return replicaBiome end
    end
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("MainInterface")
    if not main then return nil end
    for _, container in ipairs(main:GetChildren()) do
        if container:IsA("TextLabel") and container.Visible then
            local visibleBiomeLabels = 0
            local detected
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("TextLabel") and child.Visible then
                    local normalized = normalizeBiome(child.Text)
                    if normalized then
                        visibleBiomeLabels += 1
                        detected = detected or normalized
                    end
                end
            end
            if visibleBiomeLabels >= 3 then return "GLITCHED" end
            if detected then return detected end
        end
    end
end

local function updateStatus()
    pcall(function()
        local online = State.Running and "online" or "offline"
        if Controls.MainBadge then Controls.MainBadge:SetState(online) end
        if Controls.StatusBadge then Controls.StatusBadge:SetState(online) end
        if Controls.Elapsed and Controls.Elapsed.ValueLabel then
            Controls.Elapsed.ValueLabel.Text = State.Running and formatElapsed(os.clock() - State.StartedAt) or "00:00:00"
        end
        if Controls.LastBiome and Controls.LastBiome.ValueLabel then Controls.LastBiome.ValueLabel.Text = tostring(State.LastBiome) end
        if Controls.SessionBiomes and Controls.SessionBiomes.ValueLabel then Controls.SessionBiomes.ValueLabel.Text = tostring(State.SessionBiomes) end
        if Controls.SessionMerchants and Controls.SessionMerchants.ValueLabel then Controls.SessionMerchants.ValueLabel.Text = tostring(State.SessionMerchants) end
        if Controls.Alerts and Controls.Alerts.ValueLabel then Controls.Alerts.ValueLabel.Text = tostring(State.AlertsSent) end
        if Controls.Counts then
            for biome, metric in pairs(Controls.Counts) do
                if metric.ValueLabel then metric.ValueLabel.Text = tostring(State.Counts[biome] or 0) end
            end
        end
    end)
end

