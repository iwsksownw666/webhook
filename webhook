        if Controls.LastBiome and Controls.LastBiome.ValueLabel then Controls.LastBiome.ValueLabel.Text = tostring(State.LastBiome) end
        if Controls.SessionBiomes and Controls.SessionBiomes.ValueLabel then Controls.SessionBiomes.ValueLabel.Text = tostring(State.SessionBiomes) end
        if Controls.SessionMerchants and Controls.SessionMerchants.ValueLabel then Controls.SessionMerchants.ValueLabel.Text = tostring(State.SessionMerchants) end
        if Controls.Alerts and Controls.Alerts.ValueLabel then Controls.Alerts.ValueLabel.Text = tostring(State.AlertsSent) end
        if Controls.MainWorldWeather and Controls.MainWorldWeather.ValueLabel then Controls.MainWorldWeather.ValueLabel.Text = observed or "Unavailable" end
        if Controls.WeatherSource and Controls.WeatherSource.ValueLabel then Controls.WeatherSource.ValueLabel.Text = WeatherSource end
        if Controls.Counts then
            for biome, metric in pairs(Controls.Counts) do
                if metric.ValueLabel then metric.ValueLabel.Text = tostring(State.Counts[biome] or 0) end
            end
        end
    end)
end

announceMerchant = function(id)
    id = tostring(id)
    if not State.Running or MerchantNotified[id] or MerchantPending[id] then return end
    local retry = MerchantRetries[id]
    if retry and (retry.Attempts >= 3 or os.clock() < retry.After) then return end
    MerchantPending[id] = true
    local generation = State.Generation
    task.spawn(function()
        local deadline = os.clock() + 6
        while Alive and State.Running and State.Generation == generation and os.clock() < deadline do
            refreshMerchants(false)
            local data = MerchantCache[id]
            if not data or data.stock_complete then break end
            task.wait(0.15)
        end
        local data = MerchantCache[id]
        if Alive and State.Running and State.Generation == generation and data and merchantRemaining(data) ~= "Expired" then
            State.LastMerchant = tostring(data.merchant_name or "Merchant")
            if not data.Counted then
                State.SessionMerchants += 1
                data.Counted = true
            end
            log("Merchant detected: " .. State.LastMerchant .. " (" .. tostring(#merchantProducts(data)) .. " products)", "INFO")
            local ok = sendMerchant(data)
            if ok then
                MerchantNotified[id] = true
                MerchantRetries[id] = nil
            else
                local attempts = (MerchantRetries[id] and MerchantRetries[id].Attempts or 0) + 1
                MerchantRetries[id] = { Attempts = attempts, After = os.clock() + math.min(60, 15 * attempts) }
            end
            updateStatus()
        end
        MerchantPending[id] = nil
    end)
end

refreshMerchants = function(announce)
    if WeatherBridge and WeatherBridge.Parent then
        local encoded = WeatherBridge:GetAttribute("Merchants")
        if type(encoded) == "string" and encoded ~= MerchantRevision then
            local ok, data = pcall(HttpService.JSONDecode, HttpService, encoded)
            if ok and type(data) == "table" then
                for id, merchant in pairs(data) do
                    local old = MerchantCache[id]
                    if old and old.Counted then merchant.Counted = true end
                end
                MerchantCache = data
                MerchantRevision = encoded
            end
        end
    end
    if announce and State.Running then
        for id in pairs(MerchantCache) do announceMerchant(id) end
    end
end

