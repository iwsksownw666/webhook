local function resolveRequest()
    local candidates = {
        ENV.request, ENV.http_request,
        type(ENV.syn) == "table" and ENV.syn.request or nil,
        type(ENV.http) == "table" and ENV.http.request or nil,
        type(ENV.fluxus) == "table" and ENV.fluxus.request or nil,
    }
    for _, candidate in ipairs(candidates) do
        if type(candidate) == "function" then return candidate end
    end
end
requestFunction = resolveRequest()

local function postWebhook(payload)
    local destination = trim(Config.Webhook)
    if not isWebhook(destination) then return false, "No valid Discord webhook configured" end
    if type(requestFunction) ~= "function" then return false, "Executor HTTP request API unavailable" end
    local okBody, body = pcall(HttpService.JSONEncode, HttpService, payload)
    if not okBody then return false, "JSON encode failed: " .. tostring(body) end
    local ok, response = pcall(requestFunction, {
        Url = destination, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body,
    })
    if not ok then return false, tostring(response) end
    if type(response) == "table" then
        local status = tonumber(response.StatusCode or response.Status)
        if status and (status < 200 or status >= 300) then
            return false, "HTTP " .. tostring(status) .. ": " .. tostring(response.Body or "")
        end
    end
    return true, response
end

local function privateServerText()
    local link = trim(Config.PSLink)
    if link == "" then return "**Private Server:**\nNot configured" end
    if isWebhook(link) then return "**Private Server:**\nNot configured" end
    if not link:match("^https://[%w%.%-]*roblox%.com/") then return "**Private Server:**\nNot configured" end
    return "**Private Server Link:**\n" .. link
end

local function quote(text)
    return "> " .. tostring(text):gsub("\n", "\n> ")
end

local function sendCard(key, description, color, rare, thumbnailId, footerLabel)
    local now = os.clock()
    if lastSendAt[key] and now - lastSendAt[key] < 2 then
        return false, "Duplicate suppressed"
    end
    lastSendAt[key] = now
    local unix = DateTime.now().UnixTimestamp
    local timeLine = string.format("<t:%d:F> (<t:%d:R>)", unix, unix)
    local embed = { description = timeLine .. "\n\n" .. quote(description), color = color, footer = footer(footerLabel) }
    local thumbnail = assetImage(thumbnailId)
    if thumbnail then embed.thumbnail = { url = thumbnail } end
    local payload = {
        allowed_mentions = { parse = rare and { "everyone" } or {} },
        embeds = { embed },
    }
    if rare then payload.content = "@everyone" end
    local ok, result = postWebhook(payload)
    if ok then
        State.AlertsSent += 1
        log("Webhook delivered: " .. key, "INFO")
    else
        log("Webhook failed: " .. tostring(result), "ERROR")
    end
    return ok, result
end

