local function normalizeBiome(value)
    if value == nil then return nil end
    local text = tostring(value):gsub("<.->", ""):gsub("[%[%]]", ""):gsub("_", " "):gsub("%-", " "):upper():gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "NORMAL" or text == "NONE" or text == "NIL" then return "NORMAL" end
    if text == "SANDSTORM" then return "SAND STORM" end
    if text == "BLOODRAIN" then return "BLOOD RAIN" end
    for _, biome in ipairs(BIOMES) do
        if text == biome then return biome end
    end
end

local function connectWeatherReplica()
    local handlers = game:GetService("ReplicatedFirst"):FindFirstChild("ClientHandlers")
    local runner = ENV.run_on_actor or run_on_actor
    if handlers and handlers:IsA("Actor") and type(runner) == "function" then
        local coreGui = game:GetService("CoreGui")
        local old = coreGui:FindFirstChild("BonesHubWeatherBridge")
        if old then old:Destroy() end
        WeatherBridge = Instance.new("Folder")
        WeatherBridge.Name = "BonesHubWeatherBridge"
        WeatherBridge:SetAttribute("Active", true)
        WeatherBridge.Parent = coreGui
        local ok, err = pcall(runner, handlers, [[
            local bridge = game:GetService("CoreGui"):FindFirstChild("BonesHubWeatherBridge")
            if not bridge then return end
            local connections = {}
            local jobs = {}
            local function alive()
                return bridge.Parent ~= nil and bridge:GetAttribute("Active") == true
            end
            local ok, err = pcall(function()
                local replica = require(game:GetService("ReplicatedStorage").Modules.Utility.Replica).GetServerReplica()
                if not alive() then return end
                local function publish()
                    if not alive() then return end
                    local data = replica.Data
                    bridge:SetAttribute("BiomeName", data.BiomeName)
                    bridge:SetAttribute("Biome", data.Biome)
                    bridge:SetAttribute("UpdatedAt", workspace:GetServerTimeNow())
                    bridge:SetAttribute("Ready", true)
                end
                for _, field in ipairs({ "BiomeName", "Biome" }) do
                    local bound, connection = pcall(function()
                        return replica:ListenToChange(field, function() task.defer(publish) end)
                    end)
                    if bound and connection then table.insert(connections, connection) end
                end
                table.insert(jobs, task.spawn(function()
                    local merchantOk, merchantError = pcall(function()
                        local rs = game:GetService("ReplicatedStorage")
                        local http = game:GetService("HttpService")
                        local store = require(rs.Modules.UI.Merchant.MerchantUIBeta).store
                        local remote = rs.Remote.Merchant
                        local stocks, snapshots, retired = {}, {}, {}
                        local queue = {}
                        local function activeMerchant(data)
                            if type(data) ~= "table" then return false end
                            if typeof(data.model) == "Instance" and not data.model:IsDescendantOf(game) then return false end
                            local life, start = tonumber(data.life_time), tonumber(data.spawned_at)
                            return not (life and start and life < math.huge and start + life <= workspace:GetServerTimeNow())
                        end
                        local function queryStock(id, productId)
                            local done, success, result = false, false, nil
                            local job = task.spawn(function()
                                success, result = pcall(function()
                                    return remote.GetData:InvokeServer("GetShopProductQuantityInfo", id, productId)
                                end)
                                done = true
                            end)
                            local deadline = os.clock() + 3
                            while alive() and not done and os.clock() < deadline do task.wait(0.05) end
                            if not done then pcall(task.cancel, job) return nil end
                            if success and type(result) == "number" and result == result and result >= 0 then
                                return result == math.huge and "Unlimited" or math.floor(result)
                            end
                        end
                        for _ = 1, 3 do
                            table.insert(jobs, task.spawn(function()
                                while alive() do
                                    local request = table.remove(queue, 1)
                                    if request then
                                        local value = queryStock(request.Id, request.ProductId)
                                        if alive() then
                                            if request.Product.StockLeft == nil then request.Product.StockLeft = value end
                                            request.Snapshot.Pending -= 1
                                            request.Snapshot.stock_complete = request.Snapshot.Pending == 0
                                        end
                                    else task.wait(0.1) end
                                end
                            end))
                        end
                        table.insert(connections, remote.ProductQuantityUpdated.OnClientEvent:Connect(function(id, productId, amount)
                            local products = stocks[tostring(id)]
                            local product = products and products[tostring(productId)]
                            if product and type(amount) == "number" and amount >= 0 then
                                product.StockLeft = amount == math.huge and "Unlimited" or math.floor(amount)
                            end
                        end))
                        table.insert(connections, remote.MerchantDespawned.OnClientEvent:Connect(function(id)
                            retired[tostring(id)] = true
                        end))
                        while alive() do
                            local output = {}
                            for key, data in pairs(store.merchant_infos) do
                                local id = tostring(data.merchant_id or key)
                                if not retired[id] and activeMerchant(data) then
                                    local snapshot = snapshots[id]
                                    if not snapshot then
                                        local life = tonumber(data.life_time)
                                        snapshot = {
                                            merchant_id = id, merchant_name = tostring(data.merchant_name or "Merchant"),
                                            spawned_at = tonumber(data.spawned_at) or workspace:GetServerTimeNow(),
                                            life_time = life and life < math.huge and life or nil,
                                            permanent = life == math.huge, product_list = {}, Pending = 0,
                                        }
                                        snapshots[id] = snapshot
                                        stocks[id] = {}
                                        for productId, source in pairs(data.product_list or {}) do
                                            if type(source) == "table" then
                                                local product = {}
                                                for _, field in ipairs({ "ProductName", "ProductDisplayName", "Price", "CurrencyType", "CurrencyName", "CurrencyDisplayName", "Index" }) do
                                                    local value = source[field]
                                                    if type(value) == "string" or (type(value) == "number" and value == value and math.abs(value) < math.huge) then product[field] = value end
                                                end
                                                snapshot.product_list[tostring(productId)] = product
                                                stocks[id][tostring(productId)] = product
                                                snapshot.Pending += 1
                                                table.insert(queue, { Id = data.merchant_id or key, ProductId = productId, Product = product, Snapshot = snapshot })
                                            end
                                        end
                                        snapshot.stock_complete = snapshot.Pending == 0
                                    end
                                    output[id] = snapshot
                                end
                            end
                            local encoded = http:JSONEncode(output)
                            if bridge:GetAttribute("Merchants") ~= encoded then bridge:SetAttribute("Merchants", encoded) end
                            bridge:SetAttribute("MerchantsReady", true)
                            task.wait(0.5)
                        end
                    end)
                    if not merchantOk and alive() then bridge:SetAttribute("MerchantError", tostring(merchantError)) end
                end))
                while alive() do publish() task.wait(0.25) end
            end)
            for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
            for _, job in ipairs(jobs) do pcall(task.cancel, job) end
            if not ok and alive() then
                bridge:SetAttribute("Ready", false)
                bridge:SetAttribute("Error", tostring(err))
            end
        ]])
        if not ok then log("Actor weather bridge failed: " .. tostring(err), "WARN") end
        return
    end
    local ok, controller = pcall(require, ReplicatedStorage:FindFirstChild("ReplicaController"))
    if ok and type(controller) == "table" then
        for _, replica in pairs(controller._replicas or {}) do
            if replica.Class == "ServerInfo" then ServerReplica = replica break end
        end
    end
    if not ServerReplica then log("Main-world Replica unavailable in this executor; HUD fallback only", "WARN") end
end

local function currentBiome()
    if WeatherBridge and WeatherBridge.Parent and WeatherBridge:GetAttribute("Ready") then
        local updated = WeatherBridge:GetAttribute("UpdatedAt")
        if type(updated) == "number" and workspace:GetServerTimeNow() - updated < 3 then
            local biome = normalizeBiome(WeatherBridge:GetAttribute("BiomeName")) or normalizeBiome(WeatherBridge:GetAttribute("Biome"))
            if biome then WeatherSource = "Actor Replica" return biome end
        end
    end
    if ServerReplica and type(ServerReplica.Data) == "table" then
        local replicaBiome = normalizeBiome(ServerReplica.Data.BiomeName) or normalizeBiome(ServerReplica.Data.Biome)
        if replicaBiome then WeatherSource = "Replica" return replicaBiome end
    end
    WeatherSource = "HUD fallback"
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("MainInterface")
    if not main then return nil end
    for _, container in ipairs(main:GetChildren()) do
        if container:IsA("TextLabel") and container.Visible then
            local visibleBiomeLabels = 0
            local detected
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("TextLabel") and child.Visible then
                    local normalized = normalizeBiome(child.Text)
                    if normalized then
                        visibleBiomeLabels += 1
                        detected = detected or normalized
                    end
                end
            end
            if visibleBiomeLabels >= 3 then return "GLITCHED" end
            if detected then return detected end
        end
    end
end

local function merchantRemaining(data)
    if not data then return "Unknown" end
    if data.permanent or data.life_time == math.huge then return "Permanent" end
    local lifetime, spawned = tonumber(data.life_time), tonumber(data.spawned_at)
    if not lifetime or not spawned then return "Unknown" end
    local seconds = math.max(0, math.ceil(spawned + lifetime - workspace:GetServerTimeNow()))
    if seconds == 0 then return "Expired" end
    if seconds < 60 then return tostring(seconds) .. " sec" end
    return "~" .. tostring(math.ceil(seconds / 60)) .. " min"
end

local function merchantProducts(data)
    local products = {}
    for id, product in pairs(data and data.product_list or {}) do
        if type(product) == "table" then table.insert(products, { Id = tostring(id), Data = product }) end
    end
    table.sort(products, function(a, b)
        local ai, bi = tonumber(a.Data.Index) or math.huge, tonumber(b.Data.Index) or math.huge
        if ai ~= bi then return ai < bi end
        return a.Id < b.Id
    end)
    return products
end

buildMerchantCard = function(data)
    local products = merchantProducts(data)
    local lines = {
        "⌛ **Remaining:** " .. merchantRemaining(data),
        "📦 **Products:** " .. (data and type(data.product_list) == "table" and tostring(#products) or "Unknown"),
        "", "**Available stock**",
    }
    if not data or type(data.product_list) ~= "table" then
        table.insert(lines, "Stock data unavailable")
    elseif #products == 0 then
        table.insert(lines, "No products listed")
    else
        local length = #table.concat(lines, "\n")
        for index, entry in ipairs(products) do
            local product = entry.Data
            local name = trim(product.ProductDisplayName)
            if name == "" then name = tostring(product.ProductName or entry.Id) end
            name = name:gsub("<.->", ""):gsub("[\r\n]", " "):gsub("%*", "")
            local currency = trim(product.CurrencyDisplayName)
            if currency == "" then currency = trim(product.CurrencyName) end
            if currency == "" then currency = trim(product.CurrencyType) end
            if currency == "" then currency = "Unknown currency" end
            local price = product.Price ~= nil and tostring(product.Price) or "?"
            local stock = product.StockLeft ~= nil and (tostring(product.StockLeft) .. " left") or "stock unavailable"
            local line = "• **" .. name .. "** — " .. price .. " " .. currency .. " • " .. stock
            if length + #line > 2800 then
                table.insert(lines, "… " .. tostring(#products - index + 1) .. " more products")
                break
            end
            table.insert(lines, line)
            length += #line + 1
        end
    end
    return table.concat(lines, "\n")
end

