local function loadUILibrary()
    local cached = ENV.__BONES_HUB_UI_LIBRARY
    if type(cached) == "table" and type(cached.new) == "function" then return cached end
    local ok, result = pcall(function()
        local source = game:HttpGet(UI_URL, true)
        source = source:gsub("Sla" .. "oqUILib", "bones hub")
        source = source:gsub(LEGACY_UI_ROOT_NAME, UI_ROOT_NAME)
        source = source:gsub("rbxassetid://102126" .. "718358520", "")
        local chunk, failure = loadstring(source)
        source = nil
        if not chunk then error(failure) end
        return chunk()
    end)
    if ok and type(result) == "table" and type(result.new) == "function" then
        ENV.__BONES_HUB_UI_LIBRARY = result
        return result
    end
    return nil, "Original UI unavailable"
end

