local function processBiome(biome, initial)
    if not biome or biome == State.CurrentBiome then return end
    local previous = State.CurrentBiome
    State.CurrentBiome = biome
    State.LastBiome = biome
    if biome == "NORMAL" then
        log("Biome ended: " .. tostring(previous), "INFO")
        updateStatus()
        return
    end
    State.SessionBiomes += 1
    State.Counts[biome] = (State.Counts[biome] or 0) + 1
    log("Biome detected: " .. biome, "INFO")
    updateStatus()
    if State.Running then
        task.spawn(sendBiome, biome)
    elseif initial and RARE_BIOMES[biome] then
        task.spawn(sendBiome, biome)
    end
end

local function debounced(callback, interval)
    local busy = false
    return function(...)
        if busy then return end
        busy = true
        local args = table.pack(...)
        task.spawn(function()
            local ok, err = pcall(callback, table.unpack(args, 1, args.n))
            if not ok then log("UI action failed: " .. tostring(err), "ERROR") end
            task.wait(interval or 0.8)
            busy = false
        end)
    end
end

local function startMacro()
    if State.Running then return end
    State.Running = true
    State.StartedAt = os.clock()
    State.SessionBiomes = 0
    State.SessionMerchants = 0
    State.Generation += 1
    local generation = State.Generation
    local initial = currentBiome()
    State.CurrentBiome = "NORMAL"
    log("Macro started", "INFO")
    updateStatus()
    if isWebhook(Config.Webhook) then task.spawn(sendStarted) else log("No valid webhook configured", "WARN") end
    processBiome(initial, true)
    if refreshMerchants then task.spawn(refreshMerchants, true) end
    task.spawn(function()
        while Alive and State.Running and State.Generation == generation do
            local ok, err = pcall(function() processBiome(currentBiome(), false) end)
            if not ok then log("Biome loop error: " .. tostring(err), "ERROR") end
            task.wait(math.max(0.15, tonumber(Config.BiomeScanInterval) or 0.5))
        end
    end)
end

local function stopMacro(silent)
    if not State.Running then return end
    local elapsed = os.clock() - State.StartedAt
    State.Running = false
    State.Generation += 1
    log("Macro stopped", "INFO")
    updateStatus()
    if not silent and isWebhook(Config.Webhook) then task.spawn(sendStopped, elapsed) end
end

local function connectMerchantEvents()
    local ok, err = pcall(function()
        local remote = ReplicatedStorage:WaitForChild("Remote", 10)
        local merchantFolder = remote and remote:WaitForChild("Merchant", 10)
        local spawned = merchantFolder and merchantFolder:WaitForChild("MerchantSpawned", 10)
        local despawned = merchantFolder and merchantFolder:WaitForChild("MerchantDespawned", 10)
        if not spawned or not despawned then error("Merchant remotes missing") end
        table.insert(Connections, spawned.OnClientEvent:Connect(function(data)
            if type(data) ~= "table" or data.merchant_id == nil then return end
            local id = tostring(data.merchant_id)
            MerchantCache[id] = {
                merchant_id = id, merchant_name = data.merchant_name,
                life_time = data.life_time, spawned_at = data.spawned_at or workspace:GetServerTimeNow(),
                product_list = copy(data.product_list or {}), stock_complete = false,
            }
            announceMerchant(id)
        end))
        table.insert(Connections, despawned.OnClientEvent:Connect(function(id)
            local old = MerchantCache[tostring(id)]
            MerchantCache[tostring(id)] = nil
            if old and State.LastMerchant == old.merchant_name then State.LastMerchant = "None" end
            if old then log("Merchant left: " .. tostring(old.merchant_name), "INFO") end
        end))
        task.spawn(function()
            while Alive do refreshMerchants(State.Running) task.wait(1) end
        end)
    end)
    if not ok then log("Merchant events unavailable: " .. tostring(err), "WARN") end
end

local AuraNotifications = (function()
    local previous = ENV.__BONES_HUB_AURA_RUNTIME
    if type(previous) == "table" and type(previous.Destroy) == "function" then pcall(previous.Destroy) end
    local controller = {}
    local active, revision, generation = true, 0, 0
    local connections, queue = {}, {}
    local worker, lastSignature, current = false, nil, nil
    local delivered, observed, nextSend = 0, 0, 0
    local lastError
    local metrics

    local function finite(value)
        return type(value) == "number" and value == value and value > 0 and value < math.huge
    end

    local function minimum(value)
        if type(value) == "string" then value = value:gsub("[,%s_]", "") end
        local number = tonumber(value)
        if not finite(number) then return nil end
        return math.clamp(math.floor(number), 1, 1000000000000)
    end

    Config.AuraEnabled = Config.AuraEnabled == true
    Config.AuraPing = Config.AuraPing == true
    Config.AuraMinimum = minimum(Config.AuraMinimum) or 1000000
    Config.AuraWebhook = type(Config.AuraWebhook) == "string" and trim(Config.AuraWebhook) or ""

    local function grouped(value)
        local text = string.format("%.0f", value)
        return (text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
    end

    local function read()
        local name = trim(LocalPlayer:GetAttribute("AuraName"))
        local rarity = tonumber(LocalPlayer:GetAttribute("EquippedAuraRarity"))
        if name == "" or name:lower() == "none" or name:lower() == "nil" or not finite(rarity) then return nil end
        return { Name = name, Rarity = math.floor(rarity) }
    end

    local function signature(aura)
        return aura and (aura.Name .. "\0" .. tostring(aura.Rarity)) or ""
    end

    local function destination()
        local custom = trim(Config.AuraWebhook)
        if custom ~= "" then return custom end
        return trim(Config.Webhook)
    end

    local function updateMetrics()
        if not metrics then return end
        local values = { current and current.Name or "None", current and ("1 / " .. grouped(current.Rarity)) or "-" }
        for index, metric in ipairs(metrics) do
            if metric.ValueLabel and metric.ValueLabel.Text ~= values[index] then metric.ValueLabel.Text = values[index] end
        end
    end

    local function payload(aura, test)
        local name = aura.Name:gsub("[\r\n]", " "):sub(1, 200):gsub("([\\`*_~|>])", "\\%1")
        return {
            content = Config.AuraPing and "@everyone" or nil,
            allowed_mentions = { parse = Config.AuraPing and { "everyone" } or {} },
            embeds = { {
                title = test and "Aura Webhook Test" or "Aura Equipped",
                description = "**" .. name .. "**",
                color = 0x82DCCB,
                fields = {
                    { name = "Player", value = tostring(LocalPlayer.DisplayName) .. " (@" .. tostring(LocalPlayer.Name) .. ")", inline = true },
                    { name = "Rarity", value = "1 in " .. grouped(aura.Rarity), inline = true },
                },
                timestamp = DateTime.now():ToIsoDate(),
                footer = { text = "bones hub by Ethereal | Aura" },
            } },
        }
    end

    local function post(body, url)
        if not isWebhook(url) then return false, "Invalid aura webhook" end
        if type(requestFunction) ~= "function" then return false, "HTTP request API unavailable" end
        local encoded, json = pcall(HttpService.JSONEncode, HttpService, body)
        if not encoded then return false, "Aura payload encoding failed" end
        local done, success, response = false, false, nil
        local job = task.spawn(function()
            success, response = pcall(requestFunction, {
                Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = json, Timeout = 10,
            })
            done = true
        end)
        local deadline = os.clock() + 12
        while active and not done and os.clock() < deadline do task.wait(0.1) end
        if not done then pcall(task.cancel, job) return false, "Aura request timed out" end
        if not success or type(response) ~= "table" then return false, "Aura request failed" end
        local status = tonumber(response.StatusCode or response.Status)
        if status and status >= 200 and status < 300 then return true end
        if status == 429 then
            local delay = 2
            local ok, info = pcall(HttpService.JSONDecode, HttpService, response.Body or "")
            if ok and type(info) == "table" and finite(tonumber(info.retry_after)) then delay = tonumber(info.retry_after) end
            return false, "Aura rate limited", math.clamp(delay, 0.25, 15)
        end
        return false, status and ("Aura HTTP " .. tostring(status)) or "Aura response status unavailable"
    end

    local function permitted(entry)
        return active and entry.Generation == generation and (entry.Test or (Config.AuraEnabled and entry.Aura.Rarity >= Config.AuraMinimum))
            and entry.Destination == destination() and isWebhook(entry.Destination)
    end

    local function pump()
        if worker then return end
        worker = true
        task.spawn(function()
            while active and #queue > 0 do
                local entry = table.remove(queue, 1)
                for attempt = 1, 3 do
                    while permitted(entry) and os.clock() < nextSend do task.wait(math.min(0.25, nextSend - os.clock())) end
                    if not permitted(entry) then break end
                    local ok, err, retry = post(payload(entry.Aura, entry.Test), entry.Destination)
                    nextSend = os.clock() + (retry or 2)
                    if not active then break end
                    if ok then
                        delivered += 1
                        State.AlertsSent += 1
                        lastError = nil
                        log(entry.Test and "Aura webhook test delivered" or ("Aura equipped: " .. entry.Aura.Name .. " (1 in " .. grouped(entry.Aura.Rarity) .. ")"), "INFO")
                        break
                    end
                    lastError = err
                    if not retry or attempt == 3 then log(err, "WARN") break end
                end
            end
            worker = false
        end)
    end

    local function enqueue(aura, test)
        if not active then return false, "Aura notifier stopped" end
        local url = destination()
        if not isWebhook(url) then lastError = "Invalid aura webhook" return false, lastError end
        if #queue >= 8 then lastError = "Aura queue full" return false, lastError end
        table.insert(queue, { Aura = aura, Test = test == true, Destination = url, Generation = generation })
        pump()
        return true
    end

    local function observe(aura)
        local key = signature(aura)
        if key == lastSignature then return end
        current, lastSignature = aura, key
        updateMetrics()
        if aura then
            observed += 1
            if Config.AuraEnabled and aura.Rarity >= Config.AuraMinimum then enqueue(aura, false) end
        end
    end

    local function schedule()
        revision += 1
        local ticket = revision
        task.delay(0.2, function()
            if not active or ticket ~= revision then return end
            local first = read()
            task.delay(0.15, function()
                if not active or ticket ~= revision then return end
                local second = read()
                if signature(first) ~= signature(second) then schedule() return end
                observe(second)
            end)
        end)
    end

    function controller.SetEnabled(value)
        Config.AuraEnabled = value == true
        generation += 1
        table.clear(queue)
        current = read()
        lastSignature = signature(current)
        updateMetrics()
        saveConfig()
        return Config.AuraEnabled
    end

    function controller.SetMinimum(value)
        local number = minimum(value)
        if not number then return false end
        Config.AuraMinimum = number
        saveConfig()
        return true
    end

    function controller.SetWebhook(value)
        local url = trim(value)
        if url ~= "" and not isWebhook(url) then return false end
        Config.AuraWebhook = url
        generation += 1
        table.clear(queue)
        saveConfig()
        return true
    end

    function controller.GetState()
        return {
            Enabled = Config.AuraEnabled, MinimumRarity = Config.AuraMinimum, MentionEveryone = Config.AuraPing,
            CurrentAura = current and current.Name or nil, CurrentRarity = current and current.Rarity or nil,
            Delivered = delivered, ObservedChanges = observed, Queued = #queue, LastError = lastError,
            WebhookValid = isWebhook(destination()),
        }
    end

    function controller.Preview()
        local aura = read()
        return aura and payload(aura, false) or nil
    end

    function controller.Test()
        local aura = read()
        if not aura then return false, "No equipped aura data" end
        return enqueue(aura, true)
    end

    function controller.Mount(page)
        UI:AddDivider(page, "Aura Equipment")
        Controls.AuraEnabled = UI:AddToggle(page, "Aura Equip Alerts", Config.AuraEnabled, controller.SetEnabled)
        Controls.AuraMinimum = UI:AddInputNumber(page, "Minimum Rarity (1 in N)", {
            Min = 1, Max = 1000000000000, Default = Config.AuraMinimum, Placeholder = "1000000",
        }, controller.SetMinimum)
        Controls.AuraWebhook = UI:AddInput(page, "Aura Webhook URL", "Optional - uses Discord Webhook URL when empty", controller.SetWebhook)
        Controls.AuraWebhook:Set(Config.AuraWebhook)
        UI:AddToggle(page, "Aura @everyone", Config.AuraPing, function(value) Config.AuraPing = value == true saveConfig() end)
        metrics = UI:AddMetricRow(page, {
            { Label = "Equipped Aura", Value = "None", Unit = "" },
            { Label = "Rarity", Value = "-", Unit = "" },
        })
        UI:AddButtonRow(page, {
            { Text = "Test Aura Webhook", Style = "ghost", Width = 170, Callback = debounced(controller.Test, 2) },
        })
        updateMetrics()
    end

    function controller.Destroy()
        active = false
        generation += 1
        revision += 1
        table.clear(queue)
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
        if ENV.__BONES_HUB_AURA_RUNTIME == controller then ENV.__BONES_HUB_AURA_RUNTIME = nil end
    end

    current = read()
    lastSignature = signature(current)
    for _, field in ipairs({ "AuraName", "EquippedAuraRarity" }) do
        table.insert(connections, LocalPlayer:GetAttributeChangedSignal(field):Connect(schedule))
    end
    ENV.__BONES_HUB_AURA_RUNTIME = controller
    return controller
end)()

local Appearance = (function()
    local appearance = {}
    local colors = {
        Canvas = Color3.fromRGB(14, 19, 27), Panel = Color3.fromRGB(20, 28, 39),
        Raised = Color3.fromRGB(28, 39, 53), Border = Color3.fromRGB(48, 64, 82),
        Text = Color3.fromRGB(233, 240, 247), Muted = Color3.fromRGB(153, 173, 193),
        Accent = Color3.fromRGB(130, 220, 203),
    }

    local function gray(color)
        return math.abs(color.R - color.G) < 0.035 and math.abs(color.G - color.B) < 0.035
    end

    function appearance.Style(object)
        if object:IsA("GuiObject") then
            local color = object.BackgroundColor3
            if object.BackgroundTransparency < 1 and gray(color) then
                if color.R < 0.055 then object.BackgroundColor3 = colors.Canvas
                elseif color.R < 0.11 then object.BackgroundColor3 = colors.Panel
                elseif color.R < 0.17 then object.BackgroundColor3 = colors.Raised
                elseif color.R < 0.3 then object.BackgroundColor3 = colors.Border end
            end
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                if gray(object.TextColor3) then
                    if object.TextColor3.R >= 0.75 then object.TextColor3 = colors.Text
                    elseif object.TextColor3.R >= 0.3 then object.TextColor3 = colors.Muted end
                end
                if object:IsA("TextBox") then object.ClearTextOnFocus = false end
                if object:IsA("TextLabel") and object.Text == "bones hub" then
                    object.TextColor3 = colors.Accent
                end
            elseif object:IsA("ScrollingFrame") then
                object.ScrollBarImageColor3 = colors.Accent
                object.ScrollBarThickness = 3
            end
        elseif object:IsA("UIStroke") and gray(object.Color) then
            object.Color = colors.Border
            object.Transparency = math.max(object.Transparency, 0.25)
        end
    end

    function appearance.Finish(gui)
        if not gui then return end
        for _, object in ipairs(gui:GetDescendants()) do appearance.Style(object) end
    end
    return appearance
end)()

local MovementCoordinator = (function()
    local controller = {}
    local owner, ticket, serial = nil, nil, 0
    local queue = {}
    function controller.Acquire(name)
        if owner == name then return ticket end
        if not table.find(queue, name) then queue[#queue + 1] = name end
        if owner or queue[1] ~= name then return nil end
        table.remove(queue, 1)
        serial += 1
        owner, ticket = name, serial
        return ticket
    end
    function controller.Release(name, lease)
        if owner ~= name or ticket ~= lease then return false end
        owner, ticket = nil, nil
        return true
    end
    function controller.Cancel(name)
        local index = table.find(queue, name)
        if index then table.remove(queue, index) end
    end
    function controller.IsOwner(name, lease)
        return owner == name and (lease == nil or lease == ticket)
    end
    function controller.Wants(name)
        return table.find(queue, name) ~= nil
    end
    function controller.GetState()
        return { Owner = owner, Ticket = ticket, Waiting = table.clone(queue) }
    end
    return controller
end)()

local Potion = (function()
    local controller = {}
    local enabled, busy, alive = false, false, true
    local epoch, completed, nextAttempt, sequence = 0, 0, 0, 0
    local bridge, inFlight, mounted, movingHumanoid, navigationOwner
    local status, lastError = "Loading recipes", nil
    local rows = {}
    local namespace, recipeName = "StellaCauldron", "Heavenly Potion"
    local pendingOutcomes = {}
    local selectedRecipes = {}
    local selector, selectorSignature
    local syncingRecipes = false
    local movementTicket

    local function setStatus(value, err)
        status, lastError = value, err
    end

    local function plan(data)
        if type(data) ~= "table" or type(data.Ingredients) ~= "table" or #data.Ingredients == 0 then
            return false, false
        end
        local ready, filled = true, true
        for _, ingredient in ipairs(data.Ingredients) do
            local required = tonumber(ingredient.Required)
            local added, owned = tonumber(ingredient.Added), tonumber(ingredient.Owned)
            if not required or required <= 0 or not added or added < 0 or not owned or owned < 0 then
                return false, false
            end
            local missing = math.max(0, required - added)
            if owned < missing then ready = false end
            if missing > 0 then filled = false end
        end
        return ready, filled
    end

    local function readSnapshot(name)
        if not bridge or not bridge.Parent then return nil end
        local updated, encoded = bridge:GetAttribute("UpdatedAt"), bridge:GetAttribute("Snapshot")
        if type(updated) ~= "number" or workspace:GetServerTimeNow() - updated > 3 or type(encoded) ~= "string" then return nil end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, encoded)
        name = name or recipeName
        if ok and type(data) == "table" then
            if data.ByRecipe then
                local value = data.ByRecipe[name]
                if value then value.Recipes = data.Recipes end
                return value
            end
            if data.Recipe == nil or data.Recipe == name then return data end
        end
    end

    local function currentCharacter()
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if humanoid and humanoid.Health > 0 and root then return character, humanoid, root end
    end

    local function active(token)
        return alive and Alive and epoch == token
    end

    local function callRemote(remote, token, ...)
        if not active(token) then return false, "Stopped" end
        local requestedRecipe = select(2, ...)
        if not table.find(selectedRecipes, requestedRecipe) then return false, "Recipe not selected", "rejected" end
        if inFlight then return false, "Request pending" end
        sequence += 1
        local ticket, arguments = sequence, table.pack(...)
        inFlight = ticket
        local done, result = false, nil
        task.spawn(function()
            result = table.pack(pcall(function()
                if not active(token) or not table.find(selectedRecipes, requestedRecipe) then return false, "Stopped" end
                return remote:InvokeServer(table.unpack(arguments, 1, arguments.n))
            end))
            done = true
            if inFlight == ticket then inFlight = nil end
        end)
        local deadline = os.clock() + 10
        while active(token) and not done and os.clock() < deadline do task.wait(0.1) end
        if not done then return false, "Request unconfirmed; waiting without resending", "uncertain" end
        if not result[1] then return false, tostring(result[2]), "uncertain" end
        if result[2] ~= true then return false, tostring(result[3] or result[2] or "Server rejected request"), "rejected" end
        return true
    end

    local function walk(target, token, reach)
        local character, humanoid, root = currentCharacter()
        if not character then return false, "Character unavailable" end
        reach = reach or 4
        local function valid()
            return active(token) and LocalPlayer.Character == character and humanoid.Health > 0
        end
        local function distance(position)
            local delta = root.Position - position
            return math.sqrt(delta.X * delta.X + delta.Z * delta.Z), math.abs(delta.Y)
        end
        local function reached(position, radius)
            local horizontal, vertical = distance(position)
            return horizontal <= radius and vertical <= 10
        end
        if reached(target, reach) then return true end
        movingHumanoid = humanoid
        local totalDeadline = os.clock() + 150
        for _ = 1, 8 do
            if not valid() or os.clock() >= totalDeadline then break end
            local path = game:GetService("PathfindingService"):CreatePath({ AgentRadius = 1.25, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 3 })
            local done, computed = false, false
            task.spawn(function()
                computed = pcall(function() path:ComputeAsync(root.Position, target) end)
                done = true
            end)
            local deadline = math.min(totalDeadline, os.clock() + 8)
            while valid() and not done and os.clock() < deadline do task.wait(0.1) end
            if not valid() or not done then break end
            if not computed or path.Status ~= Enum.PathStatus.Success then task.wait(0.3) continue end
            local blockedIndex, index = math.huge, 1
            local connection = path.Blocked and path.Blocked:Connect(function(value) if value >= index then blockedIndex = value end end)
            for waypointIndex, waypoint in ipairs(path:GetWaypoints()) do
                index = waypointIndex
                if not valid() or os.clock() >= totalDeadline then break end
                if reached(target, reach) then break end
                if reached(waypoint.Position, 1.5) then continue end
                local movePosition = waypoint.Position
                if waypoint.Action == Enum.PathWaypointAction.Jump then movePosition += Vector3.new(0, 3, 0) end
                humanoid:MoveTo(movePosition)
                if waypoint.Action == Enum.PathWaypointAction.Jump then
                    humanoid.Jump = true
                    if humanoid.ChangeState then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
                end
                local best = distance(waypoint.Position)
                local lastProgress, lastJump = os.clock(), 0
                local waypointDeadline = math.min(totalDeadline, os.clock() + 7)
                while valid() and not reached(waypoint.Position, 1.5) and os.clock() < waypointDeadline and blockedIndex > index do
                    local current = distance(waypoint.Position)
                    if current < best - 0.3 then best, lastProgress = current, os.clock() end
                    if os.clock() - lastProgress > 0.8 and os.clock() - lastJump > 1 and (not humanoid.FloorMaterial or humanoid.FloorMaterial ~= Enum.Material.Air) then
                        humanoid.Jump = true
                        if humanoid.ChangeState then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
                        humanoid:MoveTo(movePosition)
                        lastJump = os.clock()
                    end
                    if os.clock() - lastProgress > 2.5 then break end
                    task.wait(0.1)
                end
                if not reached(waypoint.Position, 1.5) then break end
            end
            if connection then connection:Disconnect() end
            if valid() and reached(target, reach) then movingHumanoid = nil return true end
            if valid() then task.wait(0.25) end
        end
        if valid() then humanoid:MoveTo(root.Position) end
        movingHumanoid = nil
        return false, "Route blocked"
    end

    local function walkPortal(portal, token, reach)
        local _, humanoid, root = currentCharacter()
        if not root then return false, "Character unavailable" end
        local map = workspace:FindFirstChild("Map")
        local bridgeModel = map and map:FindFirstChild("Bridge")
        local planks = bridgeModel and bridgeModel:FindFirstChild("Planks")
        local east = portal.X > 420 and portal.X < 650 and root.Position.X > 0 and root.Position.X < 420
        local west = portal.X > 0 and portal.X < 360 and root.Position.X > 360 and root.Position.X < 650
        if east or west then
            local direction = east and 1 or -1
            local points = {}
            local function collect()
                table.clear(points)
                map = workspace:FindFirstChild("Map")
                bridgeModel = map and map:FindFirstChild("Bridge")
                planks = bridgeModel and bridgeModel:FindFirstChild("Planks")
                if planks then
                    for _, part in ipairs(planks:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then points[#points + 1] = part.Position end
                    end
                end
            end
            collect()
            if #points < 2 then
                local anchor = bridgeModel and bridgeModel:GetPivot().Position or Vector3.new(390, 96, -316.5)
                task.spawn(function() pcall(function() LocalPlayer:RequestStreamAroundAsync(anchor, 5) end) end)
                local streamDeadline = os.clock() + 6
                repeat task.wait(0.15) collect() until #points >= 2 or not active(token) or os.clock() >= streamDeadline
            end
            table.sort(points, function(a, b) return direction * a.X < direction * b.X end)
            if #points < 2 then return false, "Bridge not streamed" end
            local first = points[1]
            if direction * (root.Position.X - first.X) < -2 or math.abs(root.Position.Z - first.Z) > 6 then
                local ok, err = walk(first, token, 2)
                if not ok then return false, err end
            end
            movingHumanoid = humanoid
            for _, point in ipairs(points) do
                if direction * (point.X - root.Position.X) < -1.8 then continue end
                if not active(token) or LocalPlayer.Character == nil or LocalPlayer.Character:FindFirstChild("HumanoidRootPart") ~= root or humanoid.Health <= 0 then movingHumanoid = nil return false, "Stopped" end
                local destination = point + Vector3.new(0, humanoid.HipHeight + 2, 0)
                humanoid:MoveTo(destination)
                local deadline = os.clock() + 4
                local previous, progressAt, jumped = root.Position, os.clock(), false
                while active(token) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") == root and humanoid.Health > 0 and os.clock() < deadline do
                    local delta = root.Position - destination
                    if math.sqrt(delta.X * delta.X + delta.Z * delta.Z) < 1.8 then break end
                    if root.Position.Y < point.Y - 4 then movingHumanoid = nil return false, "Fell off bridge" end
                    if (root.Position - previous).Magnitude > 0.3 then previous, progressAt = root.Position, os.clock() end
                    if not jumped and os.clock() - progressAt > 0.6 then
                        humanoid.Jump = true
                        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                        humanoid:MoveTo(destination)
                        jumped = true
                    end
                    task.wait(0.05)
                end
                if not active(token) or LocalPlayer.Character == nil or LocalPlayer.Character:FindFirstChild("HumanoidRootPart") ~= root or humanoid.Health <= 0 then movingHumanoid = nil return false, "Stopped" end
                if os.clock() >= deadline then movingHumanoid = nil return false, "Bridge blocked" end
            end
            movingHumanoid = nil
        end
        return walk(portal, token, reach or 2)
    end


    local function cauldronPosition()
        local cauldron = workspace:FindFirstChild("Cauldron")
        if cauldron and cauldron:IsA("Model") then return cauldron:GetPivot().Position end
    end

    local function portalPosition(destination)
        local _, _, root = currentCharacter()
        if not root then return nil end
        local selected, best
        for _, portal in ipairs(game:GetService("CollectionService"):GetTagged("StellaPortal")) do
            local position = portal:IsA("Model") and portal:GetPivot().Position or portal:IsA("BasePart") and portal.Position
            if position and (position - destination).Magnitude > 500 then
                local distance = (position - root.Position).Magnitude
                if not best or distance < best then selected, best = position, distance end
            end
        end
        return selected
    end

    local function travel(destination, token, reach)
        local character, humanoid, root = currentCharacter()
        if not root then return false, "Character unavailable" end
        if (root.Position - destination).Magnitude > 1000 then
            local data = readSnapshot()
            if not data or not data.PortalUnlocked then return false, "Stella shortcut is locked" end
            local portal = portalPosition(destination)
            if not portal then return false, "Portal unavailable" end
            setStatus("Walking to portal")
            local ok, err = walkPortal(portal, token)
            if not ok then return false, err end
            local deadline = os.clock() + 10
            movingHumanoid = humanoid
            while active(token) and LocalPlayer.Character == character and humanoid.Health > 0 and (root.Position - destination).Magnitude > 1000 and os.clock() < deadline do
                humanoid:MoveTo(portal)
                task.wait(0.25)
            end
            movingHumanoid = nil
            if not active(token) then return false, "Stopped" end
            if LocalPlayer.Character ~= character or humanoid.Health <= 0 then return false, "Character changed" end
            if (root.Position - destination).Magnitude > 1000 then return false, "Portal did not respond" end
        end
        return walkPortal(destination, token, reach)
    end

    local function awaitData(predicate, token, seconds)
        local deadline = os.clock() + seconds
        while active(token) and os.clock() < deadline do
            local data = readSnapshot()
            if data and predicate(data) then return data end
            task.wait(0.15)
        end
    end

    local function cycleRecipe(token)
        local data = readSnapshot()
        local ready = plan(data)
        if not data then setStatus("Waiting for inventory") return end
        if inFlight then setStatus("Request pending") return end
        if pendingOutcomes[recipeName] then
            if data.Count > pendingOutcomes[recipeName] then
                completed += 1
                pendingOutcomes[recipeName] = nil
                setStatus("Craft confirmed")
            else
                setStatus("Craft unconfirmed; resending paused")
                return
            end
        end
        local available = false
        for _, ingredient in ipairs(data.Ingredients or {}) do
            if ingredient.Required > ingredient.Added and ingredient.Owned > 0 then available = true break end
        end
        if not ready and not available then setStatus("Waiting for ingredients") return end
        local _, _, root = currentCharacter()
        local target = cauldronPosition()
        if not root or not target then setStatus("Waiting for cauldron") return end
        setStatus("Walking to cauldron")
        local arrived, movementError = travel(target, token, 9)
        if not arrived then setStatus("Movement paused", movementError) nextAttempt = os.clock() + 30 return end
        local function make()
            if not active(token) then return end
            local latest = readSnapshot()
            local _, filled = plan(latest)
            if not latest then return end
            local _, _, currentRoot = currentCharacter()
            if not currentRoot or (currentRoot.Position - target).Magnitude > 12 then setStatus("Outside crafting range") return end
            local remote = ReplicatedStorage:FindFirstChild("Remote")
            remote = remote and remote:FindFirstChild("Crafting")
            if not remote then error("Crafting remotes unavailable") end
            if not filled then
                setStatus("Adding ingredients")
                local expected = {}
                for _, ingredient in ipairs(latest.Ingredients) do
                    expected[ingredient.Name] = math.min(ingredient.Required, ingredient.Added + ingredient.Owned)
                end
                local ok, err = callRemote(remote.AddAllIngredients, token, namespace, recipeName, false)
                if not ok then setStatus("Add failed", err) nextAttempt = os.clock() + 30 return end
                latest = awaitData(function(value)
                    for _, ingredient in ipairs(value.Ingredients) do
                        if ingredient.Added < (expected[ingredient.Name] or ingredient.Required) then return false end
                    end
                    return true
                end, token, 8)
                if not latest then setStatus("Ingredients unconfirmed; crafting paused") nextAttempt = os.clock() + 30 return end
                local _, complete = plan(latest)
                if not complete then setStatus("Materials added; waiting for remaining ingredients") return end
            end
            if not active(token) then return end
            latest = readSnapshot()
            local _, complete = plan(latest)
            local _, _, craftRoot = currentCharacter()
            if not complete or not craftRoot or (craftRoot.Position - target).Magnitude > 12 then setStatus("Craft check failed") return end
            local previousCount = latest.Count
            setStatus("Crafting " .. recipeName)
            pendingOutcomes[recipeName] = previousCount
            local ok, err, outcome = callRemote(remote.CraftRecipe, token, namespace, recipeName)
            if not ok then
                if outcome == "rejected" then pendingOutcomes[recipeName] = nil end
                setStatus("Craft failed", err)
                nextAttempt = os.clock() + 30
                return
            end
            local confirmed = awaitData(function(value) return value.Count > previousCount end, token, 8)
            if confirmed then
                completed += 1
                pendingOutcomes[recipeName] = nil
                log(recipeName .. " crafted; inventory " .. tostring(previousCount) .. " -> " .. tostring(confirmed.Count), "INFO")
                setStatus("Craft confirmed")
            else
                setStatus("Inventory unconfirmed; crafting paused")
                nextAttempt = os.clock() + 30
            end
        end
        local ok, err = pcall(make)
        if not ok then setStatus("Crafting paused", tostring(err)) nextAttempt = os.clock() + 30 end
    end

    local function cycle(token)
        local _, _, root = currentCharacter()
        if not root then return end
        local idlePosition = root.Position
        for _, name in ipairs(copy(selectedRecipes)) do
            if not active(token) or inFlight then break end
            recipeName = name
            if bridge then bridge:SetAttribute("Recipe", name) end
            local data = readSnapshot()
            if not data then
                data = awaitData(function() return true end, token, 2)
            end
            if data then cycleRecipe(token) end
        end
        local target = cauldronPosition()
        local _, _, finalRoot = currentCharacter()
        if not target or not finalRoot or (finalRoot.Position - idlePosition).Magnitude <= 5 then return end
        if active(token) and (idlePosition - target).Magnitude > 15 then
            local previousStatus, previousError = status, lastError
            setStatus("Returning to idle position", previousError)
            local returned, returnError = travel(idlePosition, token, 5)
            if returned then setStatus(previousStatus, previousError) else setStatus("Return route blocked", returnError) nextAttempt = os.clock() + 30 end
        end
    end

    local function launch()
        if busy or not alive then return false end
        local available = false
        for _, name in ipairs(selectedRecipes) do
            local data = readSnapshot(name)
            if data then
                local ready, filled = plan(data)
                if ready or filled or (pendingOutcomes[name] and data.Count > pendingOutcomes[name]) then available = true end
                for _, ingredient in ipairs(data.Ingredients or {}) do
                    if ingredient.Required > ingredient.Added and ingredient.Owned > 0 then available = true break end
                end
            end
        end
        if not available then MovementCoordinator.Cancel("Potion") return false end
        movementTicket = MovementCoordinator.Acquire("Potion")
        if not movementTicket then return false end
        busy, navigationOwner = true, "Potion"
        local token = epoch
        task.spawn(function()
            local ok, err = pcall(cycle, token)
            if not ok then setStatus("Crafting error", tostring(err)) nextAttempt = os.clock() + 30 end
            MovementCoordinator.Release("Potion", movementTicket)
            movementTicket, movingHumanoid, navigationOwner, busy = nil, nil, nil, false
            nextAttempt = math.max(nextAttempt, os.clock() + 2)
        end)
        return true
    end

    function controller.SetEnabled(value)
        enabled = value == true
        epoch += 1
        if not enabled then MovementCoordinator.Cancel("Potion") end
        if not enabled and movingHumanoid and MovementCoordinator.IsOwner("Potion", movementTicket) then
            local _, _, root = currentCharacter()
            if root then pcall(function() movingHumanoid:MoveTo(root.Position) end) end
            movingHumanoid = nil
        end
        nextAttempt = 0
        setStatus(enabled and "Auto craft enabled" or "Auto craft disabled")
        return enabled
    end

    function controller.RunOnce()
        if busy or enabled then return false, "Already running" end
        if os.clock() < nextAttempt then return false, "Retry cooldown" end
        return launch()
    end

    function controller.SelectRecipe(value)
        return controller.SelectRecipes({ value })
    end

    function controller.SelectRecipes(values)
        if type(values) ~= "table" then return false end
        local list, seen = {}, {}
        for _, value in ipairs(values) do
            if type(value) ~= "string" then return false end
            value = trim(value)
            if value ~= "" and not seen[value] then list[#list + 1], seen[value] = value, true end
        end
        epoch += 1
        nextAttempt = 0
        if #list == 0 then MovementCoordinator.Cancel("Potion") end
        if movingHumanoid and MovementCoordinator.IsOwner("Potion", movementTicket) then
            local _, _, root = currentCharacter()
            if root then pcall(function() movingHumanoid:MoveTo(root.Position) end) end
            movingHumanoid = nil
        end
        selectedRecipes = list
        recipeName = list[1] or recipeName
        if bridge then
            bridge:SetAttribute("Recipe", recipeName)
        end
        syncingRecipes = true
        if selector then pcall(function() selector:SetSelected(copy(selectedRecipes)) end) end
        syncingRecipes = false
        return true
    end

    function controller.GetState()
        local data = readSnapshot()
        local ready, filled = plan(data)
        return {
            Enabled = enabled, Busy = busy, Status = status, Error = lastError, NavigationOwner = navigationOwner,
            MovementOwner = MovementCoordinator.GetState().Owner, WaitingForMovement = MovementCoordinator.Wants("Potion"),
            Recipe = recipeName, Completed = completed, Count = data and data.Count,
            SelectedRecipes = copy(selectedRecipes),
            DataReady = data ~= nil, MaterialsReady = ready, IngredientsFilled = filled,
            Ingredients = data and copy(data.Ingredients) or {},
            PendingRequest = inFlight ~= nil, PendingOutcome = next(pendingOutcomes) ~= nil,
            PendingRecipes = copy(pendingOutcomes),
            BridgeError = bridge and bridge:GetAttribute("Error"),
            Recipes = data and copy(data.Recipes) or {},
        }
    end

    local function mountSelector(names)
        local signature = table.concat(names, "\n")
        if selector and selectorSignature == signature then return end
        if selector and selector.Frame then selector.Frame:Destroy() end
        selectorSignature = signature
        selector = UI:AddMultiSelect(mounted, "Potions", names, function(values)
            if syncingRecipes or type(values) ~= "table" then return end
            local choices = {}
            for _, name in ipairs(names) do if values[name] == true then choices[#choices + 1] = name end end
            controller.SelectRecipes(choices)
        end)
        selector:SetSelected(copy(selectedRecipes))
        if selector.Frame then selector.Frame.LayoutOrder = 0 end
    end

    function controller.Mount(page)
        mounted = page
        mountSelector({})
        UI:AddToggle(page, "Auto Craft", false, controller.SetEnabled)
    end

    function controller.Destroy()
        controller.SetEnabled(false)
        alive = false
        if bridge then bridge:SetAttribute("Active", false) bridge:Destroy() bridge = nil end
    end

    task.spawn(function()
        local runner = ENV.run_on_actor or run_on_actor
