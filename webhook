local API = {}
function API.Start() startMacro() end
function API.Stop() stopMacro() end
function API.TestBiome(biome) return sendBiome(normalizeBiome(biome) or "WINDY") end
function API.TestMerchant(merchant) return sendMerchant(tostring(merchant or "Mari")) end
function API.ProbeBiome() return currentBiome() end
function API.SetAuraEnabled(value) return AuraNotifications.SetEnabled(value) end
function API.SetAuraMinimum(value) return AuraNotifications.SetMinimum(value) end
function API.SetAuraWebhook(value) return AuraNotifications.SetWebhook(value) end
function API.GetAuraState() return AuraNotifications.GetState() end
function API.PreviewAura() return AuraNotifications.Preview() end
function API.TestAuraWebhook() return AuraNotifications.Test() end
function API.SetPotionEnabled(value) return Potion.SetEnabled(value) end
function API.GetPotionState() return Potion.GetState() end
function API.SelectPotion(value) return Potion.SelectRecipe(value) end
function API.SelectPotions(values) return Potion.SelectRecipes(values) end
function API.SetFishingEnabled(value) return FishingAutomation.SetEnabled(value) end
function API.SelectFishingAreas(values) return FishingAutomation.SelectAreas(values) end
function API.SelectFishingSpots(values) return FishingAutomation.SelectSpots(values) end
function API.GetFishingSpots() return FishingAutomation.GetSpots() end
function API.SetFishingEarly(value) return FishingAutomation.SetEarly(value) end
function API.SetFishingHideResults(value) return FishingAutomation.SetHideResults(value) end
function API.SetFishingAutoSell(value) return FishingAutomation.SetAutoSell(value) end
function API.SellAllFish() return FishingAutomation.SellAll() end
function API.CancelFishingSale() return FishingAutomation.CancelSale() end
function API.GetFishingState() return FishingAutomation.GetState() end
function API.GetMerchants()
    refreshMerchants(false)
    return copy(MerchantCache)
end
function API.PreviewMerchant(merchant)
    refreshMerchants(false)
    if type(merchant) == "table" then return buildMerchantCard(merchant) end
    for id, data in pairs(MerchantCache) do
        if id == merchant or data.merchant_name == merchant then return buildMerchantCard(data) end
    end
    return buildMerchantCard(nil)
end
function API.SetPage(page) return UI:SetPage(page) end
function API.GetState()
    local observed = currentBiome()
    return {
        Running = State.Running, CurrentBiome = State.CurrentBiome, LastBiome = State.LastBiome,
        LastMerchant = State.LastMerchant, AlertsSent = State.AlertsSent,
        WebhookValid = isWebhook(Config.Webhook), UIVisible = UI:IsVisible(),
        WeatherSource = WeatherSource,
        ObservedBiome = observed,
        MerchantDataReady = WeatherBridge ~= nil and WeatherBridge.Parent ~= nil and WeatherBridge:GetAttribute("MerchantsReady") == true,
        WeatherBridgeError = WeatherBridge and WeatherBridge:GetAttribute("Error") or nil,
        MerchantDataError = WeatherBridge and WeatherBridge:GetAttribute("MerchantError") or nil,
        WeatherBridgeReady = WeatherBridge ~= nil and WeatherBridge.Parent ~= nil and WeatherBridge:GetAttribute("Ready") == true,
    }
end
function API.Destroy()
    if not Alive then return end
    AuraNotifications.Destroy()
    FishingAutomation.Destroy()
    Potion.Destroy()
    Alive = false
    stopMacro(true)
    saveConfig()
    for _, connection in ipairs(Connections) do pcall(function() connection:Disconnect() end) end
    table.clear(Connections)
    if WeatherBridge then WeatherBridge:SetAttribute("Active", false) WeatherBridge:Destroy() WeatherBridge = nil end
    if UI then pcall(function() UI:Destroy() end) end
    if ENV[API_KEY] == API then ENV[API_KEY] = nil end
    if ENV[LEGACY_API_KEY] == API then ENV[LEGACY_API_KEY] = nil end
end

ENV[API_KEY] = API
table.insert(Connections, Players.PlayerRemoving:Connect(function(player)
    if player == LocalPlayer then saveConfig() end
end))
applyAntiAfk()
