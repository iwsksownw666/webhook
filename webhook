    local function movePoint(destination, valid, radius, seconds)
        local model, humanoid, root = character()
        if not root then return false, "Character unavailable" end
        movingHumanoid = humanoid
        local deadline, best, lastProgress = os.clock() + (seconds or 8), math.huge, os.clock()
        humanoid:MoveTo(destination)
        while valid() and LocalPlayer.Character == model and humanoid.Health > 0 and os.clock() < deadline do
            local offset = root.Position - destination
            local horizontal = Vector3.new(offset.X, 0, offset.Z).Magnitude
            if horizontal <= (radius or 2) and math.abs(offset.Y) <= 5 then return true end
            if horizontal < best - 0.2 then best, lastProgress = horizontal, os.clock() end
            if os.clock() - lastProgress > 1 then
                if humanoid.FloorMaterial ~= Enum.Material.Air then humanoid.Jump = true end
                humanoid:MoveTo(destination)
                if os.clock() - lastProgress > 3 then return false, "Route obstructed" end
            end
            task.wait(0.1)
        end
        return false, valid() and "Route timed out" or "Stopped"
    end
