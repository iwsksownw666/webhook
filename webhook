        if table.concat(taskRecipes, "\n") == table.concat(nextValues, "\n") then return end
        taskRecipes = nextValues
        if bridge then bridge:SetAttribute("RecipesNeeded", HttpService:JSONEncode(workRecipes())) end
        epoch += 1
        nextAttempt = 0
        if #workRecipes() == 0 then MovementCoordinator.Cancel("Potion") end
    end

