local function saveConfig()
    if type(writefile) ~= "function" then return false end
    local ok, err = pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(CONFIG_DIR) then
            makefolder(CONFIG_DIR)
        end
        writefile(CONFIG_FILE, HttpService:JSONEncode(Config))
    end)
    if not ok then log("Config save failed: " .. tostring(err), "ERROR") end
    return ok
end

local function loadConfig()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
    local path
    if isfile(CONFIG_FILE) then
        path = CONFIG_FILE
    elseif isfile(LEGACY_CONFIG_FILE) then
        path = LEGACY_CONFIG_FILE
    end
    if not path then return end
    local ok, result = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if ok and type(result) == "table" then
        merge(Config, result)
        if path == LEGACY_CONFIG_FILE then saveConfig() end
    end
end
