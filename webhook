    local function jumpObbySegment(finishSurface, valid)
        local model, humanoid, root = character()
        if not root then return false, "Character unavailable" end
        movingHumanoid = humanoid
        local destination = finishSurface + Vector3.new(0, 3, 0)
        local flat = Vector3.new(destination.X - root.Position.X, 0, destination.Z - root.Position.Z)
        local direction = flat.Magnitude > 0 and flat.Unit or Vector3.zero
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = supports and { model, supports } or { model }
        params.RespectCanCollide = true
        local deadline, best, lastProgress, nextMove = os.clock() + 9, math.huge, os.clock(), 0
        while valid() and LocalPlayer.Character == model and humanoid.Health > 0 and os.clock() < deadline do
            local offset = root.Position - destination
            local horizontal = Vector3.new(offset.X, 0, offset.Z).Magnitude
            if horizontal <= 4 and math.abs(offset.Y) <= 7 then movingHumanoid = nil return true end
            local now = os.clock()
            if horizontal < best - 0.25 then best, lastProgress = horizontal, now end
            if now >= nextMove then humanoid:MoveTo(destination) nextMove = now + 0.35 end
            if humanoid.FloorMaterial ~= Enum.Material.Air then
                local ahead = workspace:Raycast(root.Position + direction * 2 + Vector3.new(0, 1, 0), Vector3.new(0, -6, 0), params)
                if not ahead or finishSurface.Y > root.Position.Y - 2 and horizontal < 14 then humanoid.Jump = true end
            end
            if now - lastProgress > 2.8 then movingHumanoid = nil return false, "Jump stalled" end
            task.wait(0.08)
        end
        movingHumanoid = nil
        return false, valid() and "Jump timed out" or "Stopped"
    end
    local function walkObbyRoute(nodes, valid)
        for index = 2, #nodes do
            if not valid() then return false, "Stopped" end
            attribute("ObbyRouteStep", index)
            dailyStatus = "Obby jump " .. tostring(index - 1) .. " / " .. tostring(#nodes - 1)
            local moved, reason = jumpObbySegment(nodes[index], valid)
            if not moved then
                if not valid() then return false, reason end
                local _, humanoid, root = character()
                if not root or humanoid.FloorMaterial == Enum.Material.Air then return false, reason end
                if Config.DailyObbySupports == false then return false, reason end
                dailyStatus = "Obby jump stalled; adding short support"
                local startSurface = Vector3.new(root.Position.X, math.max(nodes[index - 1].Y, root.Position.Y - 3), root.Position.Z)
                buildObbySupport(startSurface, nodes[index])
                moved, reason = movePoint(nodes[index] + Vector3.new(0, 3, 0), valid, 4, 9)
                if not moved then return false, reason end
                clearSupports()
            end
            task.wait(0.12)
        end
        return true
    end
    local function travel(destination, valid, radius)
        local _, _, root = character()
        if not root then return false, "Character unavailable" end
        if (root.Position - destination).Magnitude > 1000 then
            local nearest, best
            for _, portal in ipairs(game:GetService("CollectionService"):GetTagged("StellaPortal")) do
                local position = portal:IsA("Model") and portal:GetPivot().Position or portal:IsA("BasePart") and portal.Position
                if position and (position - destination).Magnitude > 500 then
                    local distance = (root.Position - position).Magnitude
                    if not best or distance < best then nearest, best = position, distance end
                end
            end
            if not nearest then return false, "Stella shortcut unavailable" end
            local arrived, reason = pathWalk(nearest, valid, 3)
            if not arrived then return false, reason end
            local deadline = os.clock() + 8
            while valid() and os.clock() < deadline and (root.Position - destination).Magnitude > 1000 do
                local _, humanoid = character()
                if not humanoid then return false, "Character unavailable" end
                humanoid:MoveTo(nearest)
                task.wait(0.2)
            end
            if (root.Position - destination).Magnitude > 1000 then return false, "Portal did not respond" end
        end
        return pathWalk(destination, valid, radius)
    end
