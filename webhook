local function isWebhook(url)
    local value = trim(url)
    return value:match("^https://discord%.com/api/webhooks/%d+/[%w%-%._]+/?$") ~= nil
        or value:match("^https://discordapp%.com/api/webhooks/%d+/[%w%-%._]+/?$") ~= nil
end

