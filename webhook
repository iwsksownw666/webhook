            if table.find(areaNames, name) and not table.find(selected, name) then selected[#selected + 1] = name end
        end
        areas = selected
        if selector then pcall(function() selector:SetSelected(copy(areas)) end) end
        table.clear(blocked)
        nextAttempt = 0
        cancel()
        return true
    end

    function controller.SetEarly(value)
        early = value == true
        if bridge then bridge:SetAttribute("Early", early) end
        return early
    end

    function controller.SetHideResults(value)
        hideResults = value == true
        attribute("HideResults", hideResults)
        return hideResults
    end

    function controller.SetAutoSell(value)
        autoSell = value == true
        saleFault = false
        if not autoSell and selling then cancel() end
        return autoSell
    end

    function controller.SellAll()
        if not bridge or bridge:GetAttribute("SaleReady") ~= true then return false, "Shop listener unavailable" end
        if selling or sellRequested then return false, "Sale already queued" end
        local current = snapshot()
        if not current or current.SalePending then return false, "Sale confirmation pending" end
        saleFault, sellRequested = false, true
        cancel()
        return true
    end

    function controller.CancelSale()
        sellRequested = false
        saleFault = true
        cancel()
    end

    local function valid(token)
        return living and Alive and epoch == token
    end

local FishSpots = (function()
    local catalog, byId, byLabel, selected = {}, {}, {}, {}
    local selector, mountedPage, onChanged
    local signature, syncing = "", false
    local spots = {}
    local boundFolder, dirty, refreshAt = nil, true, 0
    local connections = {}

    local function bindFolder(folder)
        if boundFolder == folder then return end
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
        boundFolder, dirty = folder, true
        for _, signal in ipairs({ folder.ChildAdded, folder.ChildRemoved }) do
            connections[#connections + 1] = signal:Connect(function() dirty = true end)
        end
    end

    local function selectedLabels()
        local labels = {}
        for _, id in ipairs(selected) do
            if byId[id] then labels[#labels + 1] = byId[id].Label end
        end
        return labels
    end

    local function syncSelected()
        if not selector then return end
        syncing = true
        pcall(function() selector:SetSelected(selectedLabels()) end)
        syncing = false
    end

    local function same(a, b)
        if #a ~= #b then return false end
        for index, value in ipairs(a) do if b[index] ~= value then return false end end
        return true
    end

    local function publish(previous)
        if not same(previous, selected) and type(onChanged) == "function" then
            onChanged(copy(selected))
        end
    end

    local function rebuild()
        if mountedPage == nil or not UI then return end
        local order
        if selector and selector.Frame then
            pcall(function() order = selector.Frame.LayoutOrder end)
            pcall(function() selector.Frame:Destroy() end)
        end
        local labels = {}
        for _, entry in ipairs(catalog) do labels[#labels + 1] = entry.Label end
        syncing = true
        selector = UI:AddMultiSelect(mountedPage, "Fishing Spots", labels, function(values)
            if syncing then return end
            local choices = {}
            if type(values) == "table" then
                for _, entry in ipairs(catalog) do
                    if values[entry.Label] == true then choices[#choices + 1] = entry.Id end
                end
            end
            spots.Select(choices)
        end)
        if order ~= nil and selector and selector.Frame then
            pcall(function() selector.Frame.LayoutOrder = order end)
        end
        syncing = false
        syncSelected()
    end

    local function defaultFolder()
        local map = workspace:FindFirstChild("Map")
        local miscs = map and map:FindFirstChild("Miscs")
        return miscs and miscs:FindFirstChild("FishingPoints")
    end

    local function readPoint(point)
        local ok, id, area, position = pcall(function()
            local pointId = point:GetAttribute("spotId")
            local location = point:GetAttribute("locationName")
            local standing = point:GetAttribute("plrLoc")
            local at = typeof(standing) == "CFrame" and standing.Position or point:GetPivot().Position
            return pointId, location, at
        end)
        if not ok or type(id) ~= "string" or id == "" or type(area) ~= "string" or area == "" then return end
        if not position or type(position.X) ~= "number" or type(position.Z) ~= "number" then return end
        if position.X ~= position.X or position.Z ~= position.Z or math.abs(position.X) == math.huge or math.abs(position.Z) == math.huge then return end
        local label = string.format("%s | %.0f, %.0f [%s]", area, position.X, position.Z, id:sub(1, 8))
        return { Id = id, Label = label, Area = area, Model = point, X = position.X, Z = position.Z }
    end

    function spots.Refresh(pointsFolder)
        local folder = pointsFolder or defaultFolder()
        if not folder then return false end
        local ok, children = pcall(function() return folder:GetChildren() end)
        if not ok or type(children) ~= "table" then return false end
        bindFolder(folder)
        dirty, refreshAt = false, os.clock() + 30
        local entries, ids, labels = {}, {}, {}
        for _, point in ipairs(children) do
            local entry = readPoint(point)
            if entry and not ids[entry.Id] then
                entries[#entries + 1] = entry
                ids[entry.Id] = entry
                labels[entry.Label] = (labels[entry.Label] or 0) + 1
            end
        end
        for _, entry in ipairs(entries) do
            if labels[entry.Label] > 1 then
                entry.Label = string.format("%s | %.0f, %.0f [%s]", entry.Area, entry.X, entry.Z, entry.Id)
            end
        end
        table.sort(entries, function(a, b)
            if a.Area ~= b.Area then return a.Area < b.Area end
            if a.X ~= b.X then return a.X < b.X end
            if a.Z ~= b.Z then return a.Z < b.Z end
            return a.Id < b.Id
        end)
        if #entries > 4 then
            local limited, seen = {}, {}
            local anchors = {
                { "Sol's World - Main Island", 213.52, -177.34 },
                { "Sol's World - Main Island", 217.65, -172.54 },
                { "Sol's World - Island 1", 19.21, -150.54 },
                { "Sol's World - Island 2", 353.21, -70.54 },
            }
            for _, anchor in ipairs(anchors) do
                local chosen, best
                for _, entry in ipairs(entries) do
                    if entry.Area == anchor[1] and not seen[entry.Id] then
                        local distance = (entry.X - anchor[2]) ^ 2 + (entry.Z - anchor[3]) ^ 2
                        if not best or distance < best then chosen, best = entry, distance end
                    end
                end
                if chosen then limited[#limited + 1], seen[chosen.Id] = chosen, true end
            end
            for _, entry in ipairs(entries) do
                if #limited >= 4 then break end
                if not seen[entry.Id] then limited[#limited + 1], seen[entry.Id] = entry, true end
            end
            local allowed = {}
            for _, entry in ipairs(limited) do allowed[entry.Id] = true end
            local filtered = {}
            for _, entry in ipairs(entries) do if allowed[entry.Id] then filtered[#filtered + 1] = entry end end
            entries, ids = filtered, {}
            for _, entry in ipairs(entries) do ids[entry.Id] = entry end
        end
        local nextCatalog, nextByLabel, parts = {}, {}, {}
        for _, entry in ipairs(entries) do
            local public = { Id = entry.Id, Label = entry.Label, Area = entry.Area }
            nextCatalog[#nextCatalog + 1] = public
            nextByLabel[entry.Label] = entry.Id
            parts[#parts + 1] = entry.Id .. "\0" .. entry.Label .. "\0" .. entry.Area
        end
        local nextSignature = table.concat(parts, "\1")
        local previous = copy(selected)
        catalog, byId, byLabel = nextCatalog, ids, nextByLabel
        selected = {}
        for _, id in ipairs(previous) do if byId[id] then selected[#selected + 1] = id end end
        local changed = signature ~= nextSignature
        signature = nextSignature
        if changed then rebuild() end
        publish(previous)
        return changed
    end

    function spots.GetCatalog()
        return copy(catalog)
    end

    function spots.GetPoints()
        local points = {}
        for _, entry in ipairs(catalog) do points[#points + 1] = byId[entry.Id].Model end
        return points
    end

    function spots.HasSelection()
        return #selected > 0
    end

    function spots.NeedsRefresh(folder)
        return boundFolder ~= folder or dirty or os.clock() >= refreshAt
    end

    function spots.Destroy()
        for _, connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
        boundFolder = nil
    end

    function spots.Select(values)
        if type(values) ~= "table" then return false end
        local previous, nextSelected, seen = copy(selected), {}, {}
        for _, value in ipairs(values) do
            local id = type(value) == "string" and (byId[value] and value or byLabel[value]) or nil
            if id and not seen[id] then
                nextSelected[#nextSelected + 1] = id
                seen[id] = true
            end
        end
        selected = nextSelected
        syncSelected()
        publish(previous)
        return true
    end

    function spots.GetSelected()
        return copy(selected)
    end

    function spots.Contains(point)
        if #selected == 0 then return true end
        local ok, id = pcall(function() return point:GetAttribute("spotId") end)
        return ok and type(id) == "string" and table.find(selected, id) ~= nil
    end

    function spots.Mount(page, callback)
        mountedPage, onChanged = page, callback
        rebuild()
    end

    return spots
end)()

    local function walkTo(targetPosition, isActive, reach)
        local player = game:GetService("Players").LocalPlayer
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root or humanoid.Health <= 0 then return false, "Character unavailable" end
        local deadline = os.clock() + 75
        local clearance = humanoid.HipHeight + root.Size.Y / 2
        if humanoid.HipHeight == 0 then
            local leg = character:FindFirstChild("Left Leg")
            clearance += leg and leg.Size.Y or 2
        end
        reach = math.clamp(tonumber(reach) or 3, 0.5, 3.5)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character }
        params.RespectCanCollide = true
        params.IgnoreWater = true
        local edgeJumps, edgeRecoveries = {}, {}
        local jumps, recoveries, lastJump = 0, 0, -math.huge
        local function valid()
            return (not isActive or isActive()) and player.Character == character and humanoid.Health > 0
        end
        local function stop()
            if player.Character == character then
                humanoid:MoveTo(root.Position)
                humanoid.Jump = false
            end
        end
        local function waitFor(duration)
            local untilAt = math.min(deadline, os.clock() + duration)
            while valid() and os.clock() < untilAt do task.wait(math.min(0.05, untilAt - os.clock())) end
            return valid() and os.clock() < deadline
        end
        local function offset(point)
            local delta = root.Position - point
            return Vector3.new(delta.X, 0, delta.Z), delta.Y
        end
        local function arrived()
            local flat, height = offset(targetPosition)
            return flat.Magnitude <= reach and math.abs(height) <= 4
        end
        local function grounded()
            return humanoid.FloorMaterial ~= Enum.Material.Air or humanoid:GetState() == Enum.HumanoidStateType.Climbing
        end
        local gravity = math.max(tonumber(workspace.Gravity) or 196.2, 1)
        local jumpRise = humanoid.UseJumpPower == false and tonumber(humanoid.JumpHeight) or (tonumber(humanoid.JumpPower) or 50) ^ 2 / (2 * gravity)
        jumpRise = math.clamp((jumpRise or 7) - 0.5, 1, 7)
        local function jump(edge)
            if not valid() or not grounded() or jumps >= 12 or (edgeJumps[edge] or 0) >= 4 or os.clock() - lastJump < 0.8 then return false end
            humanoid.Jump = true
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            jumps += 1
            edgeJumps[edge] = (edgeJumps[edge] or 0) + 1
            lastJump = os.clock()
            return true
        end
        local function lowObstacle(point)
            local delta = point - root.Position
            local flat = Vector3.new(delta.X, 0, delta.Z)
            if flat.Magnitude < 0.1 then return false end
            local feet = root.Position - Vector3.new(0, clearance, 0)
            local obstacle = workspace:Raycast(feet + Vector3.new(0, 0.8, 0), flat.Unit * math.min(flat.Magnitude, 3.5), params)
            if not obstacle or not obstacle.Instance.CanCollide then return false end
            local above = obstacle.Position + flat.Unit * 0.8 + Vector3.new(0, jumpRise + 1.5, 0)
            local top = workspace:Raycast(above, Vector3.new(0, -jumpRise - 2.5, 0), params)
            if not top or top.Normal.Y < 0.6 then return false end
            local rise = top.Position.Y - feet.Y
            if rise < 0.5 or rise > jumpRise then return false end
            if workspace:Raycast(root.Position, Vector3.new(0, jumpRise + root.Size.Y / 2, 0), params) then return false end
            return workspace:Raycast(top.Position + Vector3.new(0, 0.2, 0), Vector3.new(0, clearance + root.Size.Y / 2 + 1, 0), params) == nil
        end
        local function runUp(point, previousPoint, edge, waypointDeadline)
            local flat = offset(point)
            if flat.Magnitude < 0.5 and previousPoint then
                local previous = previousPoint - point
                flat = Vector3.new(previous.X, 0, previous.Z)
            end
            if flat.Magnitude < 0.5 then return false end
            local back = root.Position + flat.Unit * 4.5
            local floor = workspace:Raycast(back + Vector3.new(0, 3, 0), Vector3.new(0, -clearance - 10, 0), params)
            if not floor or floor.Normal.Y < 0.6 or math.abs(floor.Position.Y - root.Position.Y + clearance) > 4.5 then return false end
            back = floor.Position + Vector3.new(0, clearance, 0)
            humanoid:MoveTo(back)
            if not waitFor(math.min(0.45, math.max(0, waypointDeadline - os.clock()))) then return false end
            if os.clock() >= waypointDeadline then return false end
            humanoid:MoveTo(point)
            local approachDeadline = math.min(deadline, waypointDeadline, os.clock() + 0.7)
            while valid() and os.clock() < approachDeadline do
                local approach = offset(point)
                if approach.Magnitude < 2.8 then return jump(edge) end
                task.wait(math.min(0.05, approachDeadline - os.clock()))
            end
            return false
        end
        local pathService = game:GetService("PathfindingService")
        for attempt = 1, 5 do
            if not valid() or os.clock() >= deadline then break end
            if arrived() then stop() return true end
            local path = pathService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 3 })
            local computed, done = false, false
            local startPosition = root.Position
            task.spawn(function()
                computed = pcall(function() path:ComputeAsync(startPosition, targetPosition) end)
                done = true
            end)
            local computeDeadline = math.min(deadline, os.clock() + 6)
            while valid() and not done and os.clock() < computeDeadline do task.wait(0.05) end
            if not valid() then break end
            if not done then stop() return false, "Path computation timed out" end
            if computed and path.Status == Enum.PathStatus.Success then
                local waypoints = path:GetWaypoints()
                local currentIndex, blockedIndex = 1, math.huge
                local connection = path.Blocked:Connect(function(index)
                    if index >= currentIndex then blockedIndex = math.min(blockedIndex, index) end
                end)
                for index, waypoint in ipairs(waypoints) do
                    currentIndex = index
                    if not valid() or os.clock() >= deadline or blockedIndex <= index or arrived() then break end
                    local point = waypoint.Position
                    local edge = string.format("%d:%d:%d", math.floor(point.X / 2), math.floor(point.Y / 2), math.floor(point.Z / 2))
                    local isJump = waypoint.Action == Enum.PathWaypointAction.Jump
                    local radius = isJump and 2 or index == #waypoints and math.min(reach, 2.5) or 2.5
                    local waypointDeadline = math.min(deadline, os.clock() + 6)
                    local best, progressAt, jumpPressed, climbRetries = math.huge, os.clock(), false, 0
                    local waypointReached = false
                    while valid() and os.clock() < waypointDeadline and blockedIndex > index do
                        local flat, height = offset(point)
                        local distance, rise = flat.Magnitude, clearance - height
                        local metric = distance + math.abs(height - clearance)
                        if metric < best - 0.2 then best, progressAt = metric, os.clock() end
                        if isJump and not jumpPressed and distance < 3 and (distance > 0.3 or rise > 0.4) then
                            jumpPressed = jump(edge)
                        end
                        local nearbyBelow = not isJump and distance < 2 and height > -1.5
                        if (distance <= radius and math.abs(height - clearance) <= 2.3) or nearbyBelow then waypointReached = true break end
                        if arrived() then waypointReached = true break end
                        humanoid:MoveTo(point)
                        local stalled = os.clock() - progressAt
                        if stalled >= 1.2 then
                            local raisedStep = isJump and rise > 1.2 and rise <= jumpRise + 0.75
                            local canRecover = grounded() and (raisedStep or lowObstacle(point))
                            if canRecover and climbRetries < 4 and recoveries < 8 and (edgeRecoveries[edge] or 0) < 3 then
                                climbRetries += 1
                                recoveries += 1
                                edgeRecoveries[edge] = (edgeRecoveries[edge] or 0) + 1
                                local previous = waypoints[index - 1]
                                if not runUp(point, previous and previous.Position, edge, waypointDeadline) then break end
                                progressAt = os.clock()
                                jumpPressed = true
                            else
                                break
                            end
                        end
                        task.wait(math.min(0.15, math.max(0, waypointDeadline - os.clock())))
                    end
                    humanoid.Jump = false
                    if not waypointReached and not arrived() then break end
                end
                connection:Disconnect()
                if valid() and arrived() then stop() return true end
            end
            stop()
            if attempt < 5 and not waitFor(0.5) then break end
        end
        stop()
        return false, not valid() and "Stopped" or os.clock() >= deadline and "Route timed out" or "Route unavailable"
    end

    local function navigate(position, token, reach)
        if not valid(token) or not MovementCoordinator.IsOwner(owner, movementTicket) then return false, "Stopped" end
        navigation = true
        local character = LocalPlayer.Character
        movingHumanoid = character and character:FindFirstChildOfClass("Humanoid")
        local ran, ok, err = pcall(walkTo, position, function()
            return valid(token) and MovementCoordinator.IsOwner(owner, movementTicket)
        end, reach or 3)
        navigation, movingHumanoid = false, nil
        if not ran then return false, tostring(ok) end
        if not valid(token) then return false, "Stopped" end
        return ok, err
    end

    local function releaseMovement()
        pause(true)
        attribute("MovementGranted", false)
        if movementTicket then MovementCoordinator.Release(owner, movementTicket) end
        MovementCoordinator.Cancel(owner)
        movementTicket = nil
    end

    local function acquireMovement()
        movementTicket = MovementCoordinator.Acquire(owner)
        local granted = movementTicket ~= nil
        attribute("MovementGranted", granted)
        return granted
    end

    local function spots()
        local map = workspace:FindFirstChild("Map")
        local miscs = map and map:FindFirstChild("Miscs")
        return miscs and miscs:FindFirstChild("FishingPoints"), miscs
    end

    local function position(spot)
        local standing = spot:GetAttribute("plrLoc")
        if typeof(standing) == "CFrame" then return standing.Position end
        return spot:GetPivot().Position
    end

    local function selectedPoint(point)
        if FishSpots.HasSelection() then return FishSpots.Contains(point) end
        return table.find(areas, point:GetAttribute("locationName")) ~= nil
    end

    function controller.SelectSpots(values)
        if not FishSpots.Select(values) then return false end
        table.clear(blocked)
        nextAttempt = 0
        cancel()
        return true
    end

    function controller.GetSpots()
        return FishSpots.GetCatalog()
    end

    local function choose()
        local root = rootPart()
        local points = spots()
        if not root or not points then return nil end
        local selected, best
        for _, point in ipairs(FishSpots.GetPoints()) do
            local id = point:GetAttribute("spotId")
            if type(id) == "string" and selectedPoint(point) and not point:GetAttribute("occupied") and (blocked[id] or 0) <= os.clock() then
                local distance = (root.Position - position(point)).Magnitude
                if not best or distance < best then selected, best = point, distance end
            end
        end
        return selected
    end

    local function sale(token)
        selling, sellRequested = true, false
        pause(true)
        bridge:SetAttribute("Spot", nil)
        target = nil
        local function perform()
            if bridge:GetAttribute("SaleReady") ~= true then return false, "Shop listener unavailable" end
            local deadline = os.clock() + 5
            local current = snapshot()
            while valid(token) and (not current or current.Fishing) and os.clock() < deadline do task.wait(0.08) current = snapshot() end
            if not valid(token) then return false, "Stopped" end
            if not current or current.Fishing then return false, "Fishing session still active" end
            if current.Count == 0 then return true end
            local _, miscs = spots()
            local shop = miscs and miscs:FindFirstChild("FishShop")
            if not shop then return false, "Fish shop unavailable" end
            local npc = shop:FindFirstChild("NPC")
            local merchant = (npc or shop):GetPivot().Position
            local ok, err = navigate(merchant, token, 3.5)
            if not ok then return false, err end
            local root = rootPart()
            if not valid(token) or not root or (root.Position - merchant).Magnitude > 4.5 then return false, "Outside merchant range" end
            local settleUntil = os.clock() + 0.25
            while valid(token) and os.clock() < settleUntil do task.wait(0.04) end
            sellSequence += 1
            bridge:SetAttribute("SaleError", nil)
            bridge:SetAttribute("SaleDone", false)
            bridge:SetAttribute("SellSequence", sellSequence)
            bridge:SetAttribute("SellAuthorized", true)
            deadline = os.clock() + 180
            while valid(token) and os.clock() < deadline do
                if bridge:GetAttribute("SaleDone") == true then return true end
                if bridge:GetAttribute("SaleError") then return false, bridge:GetAttribute("SaleError") end
                if bridge:GetAttribute("Error") then return false, bridge:GetAttribute("Error") end
                task.wait(0.15)
            end
            return false, valid(token) and "Sale timed out" or "Stopped"
        end
        local ran, ok, err = pcall(perform)
        if bridge and bridge.Parent then bridge:SetAttribute("SellAuthorized", false) end
        selling = false
        if not ran or not ok then
            lastError = ran and err or tostring(ok)
            saleFault = true
            nextAttempt = os.clock() + 10
        else lastError = nil end
    end

    local function step()
        local current = snapshot()
        if not current then releaseMovement() return end
        if MovementCoordinator.Wants("Potion") and movementTicket then
            attribute("YieldAfterCatch", true)
            if not current.Fishing and not current.SalePending and not selling then releaseMovement() return end
        else attribute("YieldAfterCatch", false) end
        if os.clock() < nextAttempt then
            pause(true)
            if not current.Fishing and not current.SalePending then releaseMovement() end
            return
        end
        local full = current.Capacity > 0 and current.Count >= current.Capacity
        local needsSale = sellRequested or (enabled and autoSell and full and not saleFault)
        if not needsSale and (not enabled or (#areas == 0 and not FishSpots.HasSelection()) or full or current.Capacity <= 0) then
            pause(true)
            if not current.Fishing and not current.SalePending then releaseMovement() end
            return
        end
        if not acquireMovement() then pause(true) return end
        if needsSale then sale(epoch) return end
        if current.Fishing then targetUsedAt = os.clock() pause(false) return end
        if target and (not target.Parent or not selectedPoint(target)) then target = nil end
        if target and target:GetAttribute("occupied") then
            if os.clock() - targetUsedAt < 1.5 then pause(true) return end
            target = nil
        end
        target = target or choose()
        if not target then releaseMovement() nextAttempt = os.clock() + 3 return end
        local selected, token = target, epoch
        local root = rootPart()
        if not root then releaseMovement() return end
        attribute("Spot", selected:GetAttribute("spotId"))
        if (root.Position - position(selected)).Magnitude > 4 then
            pause(true)
            local ok, err = navigate(position(selected), token, 3)
            if not valid(token) then return end
            if not ok then
                blocked[selected:GetAttribute("spotId")] = os.clock() + 45
                target, lastError = nil, err
                bridge:SetAttribute("Spot", nil)
                nextAttempt = os.clock() + 1.5
                return
            end
        end
        if not valid(token) or selected:GetAttribute("occupied") then target = nil return end
        lastError = nil
        pause(false)
    end

    function controller.GetState()
        local current = snapshot() or {}
        return {
            Enabled = enabled, AutoSell = autoSell, Early = early, HideResults = hideResults, Areas = copy(areas),
            SelectedSpots = FishSpots.GetSelected(), MovementOwner = MovementCoordinator.GetState().Owner,
            WaitingForMovement = MovementCoordinator.Wants(owner),
            Navigating = navigation, Selling = selling, SaleQueued = sellRequested, SalePaused = saleFault,
            Spot = target and target:GetAttribute("spotId"), Error = lastError or (bridge and (bridge:GetAttribute("Error") or bridge:GetAttribute("FishingError"))),
            Count = current.Count, Capacity = current.Capacity, Coins = current.Coins,
            Caught = current.Caught, Sold = current.Sold, EarlyConfirmed = current.EarlyConfirmed,
            SuppressedResults = current.SuppressedResults,
            DataReady = next(current) ~= nil, SaleReady = bridge and bridge:GetAttribute("SaleReady") == true,
