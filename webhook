        value(3, tostring(state.Pairs) .. "/10")
        value(4, tostring(state.Attempts))
        local rewards = {}
        for _, reward in ipairs(state.Rewards) do rewards[#rewards + 1] = reward.Name .. " x" .. reward.Quantity end
        value(5, #rewards > 0 and table.concat(rewards, ", ") or "None confirmed")
        value(6, state.WebhookStatus or "Idle")
    end
    function MemoryParty.Mount(page)
        mounted, selector, signature = page, nil, nil
        UI:AddDivider(page, "Memory Party")
        toggle = UI:AddToggle(page, "Auto Memory Party", MemoryParty.GetState().Enabled, function(value)
            if not syncing then MemoryParty.SetEnabled(value) end
        end)
        mountSelector()
        rows = {}
        for _, definitions in ipairs({
            { { Label = "Status", Value = "--", Unit = "Memory Party" }, { Label = "Cooldown", Value = "--", Unit = "Remaining" } },
            { { Label = "Matched Pairs", Value = "0/10", Unit = "Server confirmed" }, { Label = "Attempts", Value = "10", Unit = "Remaining" } },
            { { Label = "Last Rewards", Value = "None confirmed", Unit = "Matched rewards" }, { Label = "Webhook", Value = "Idle", Unit = "Delivery" } },
        }) do
            for _, metric in ipairs(UI:AddMetricRow(page, definitions)) do rows[#rows + 1] = metric end
        end
        UI:AddButtonRow(page, { { Text = "Resume Memory Party", Style = "ghost", Width = 190, Callback = function()
            local ok, err = MemoryParty.ResetSession()
            if not ok then log(err, "WARN") end
        end } })
        refresh()
    end
    function MemoryParty.MountWebhook(page)
        UI:AddDivider(page, "Memory Party Notifications")
        UI:AddToggle(page, "Memory Party Webhooks", Config.MemoryPartyWebhooks ~= false, MemoryParty.SetWebhooksEnabled)
        local input = UI:AddInput(page, "Memory Party Webhook URL", "Optional - uses Discord Webhook URL when empty", MemoryParty.SetWebhookURL)
        input:Set(Config.MemoryPartyWebhook or "")
    end
    task.spawn(function()
        while Alive do
            pcall(refresh)
            task.wait(0.5)
        end
    end)
end


