        local raw = Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
        return tonumber(raw:match("[%d%.]+")) or 0
    end)
    return ok and math.floor(value + 0.5) or 0
end

local function assetImage(assetId)
