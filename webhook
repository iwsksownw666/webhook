        if not done then return false, "Request unconfirmed; waiting without resending", "uncertain" end
        if not result[1] then return false, tostring(result[2]), "uncertain" end
        if result[2] ~= true then return false, tostring(result[3] or result[2] or "Server rejected request"), "rejected" end
        return true
    end

    local function walkPortal(target, token, reach)
        local model, humanoid = currentCharacter()
        if not model then return false, "Character unavailable" end
        movingHumanoid = humanoid
        local ok, reason = Navigation.Walk(target, function()
            return active(token) and MovementCoordinator.IsOwner("Potion", movementTicket)
        end, reach)
        if LocalPlayer.Character == model and humanoid.Health > 0 and MovementCoordinator.IsOwner("Potion", movementTicket) and not ok then
            local root = model:FindFirstChild("HumanoidRootPart")
            if root then humanoid:MoveTo(root.Position) end
        end
        movingHumanoid = nil
        return ok, reason
    end

    local function cauldronPosition()
        local cauldron = workspace:FindFirstChild("Cauldron")
        if cauldron and cauldron:IsA("Model") then return cauldron:GetPivot().Position end
    end

    local function portalPosition(destination)
        local _, _, root = currentCharacter()
