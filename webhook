            table.insert(definitions, { Label = biome, Value = "0", Unit = "detected" })
            table.insert(names, biome)
        end
    end
    local row = UI:AddMetricRow(3, definitions)
    for rowIndex, biome in ipairs(names) do Controls.Counts[biome] = row[rowIndex] end
end

