local function normalizeBiome(value)
    if value == nil then return nil end
    local text = tostring(value):gsub("<.->", ""):gsub("[%[%]]", ""):gsub("_", " "):gsub("%-", " "):upper():gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "NORMAL" or text == "NONE" or text == "NIL" then return "NORMAL" end
    local compact = text:gsub("%s", "")
    for _, biome in ipairs(BIOMES) do
        if text == biome or compact == biome:gsub("%s", "") then return biome end
    end
end

