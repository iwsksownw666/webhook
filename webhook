        if object:IsA("ProximityPrompt") or object:IsA("Model") then targetObjects[object] = true end
    end
    targetConnections[1] = workspace.DescendantAdded:Connect(add)
    targetConnections[2] = workspace.DescendantRemoving:Connect(function(object) targetObjects[object] = nil end)
